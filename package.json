{
  "name": "dropbox-index",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vp dev",
    "start": "node dist/node.js",
    "prepare": "vp config"
  },
  "dependencies": {
    "@hono/node-server": "2.1.5",
    "hono": "4.13.13"
  },
  "devDependencies": {
    "@hono/vite-dev-server": "0.26.1",
    "@types/node": "22.20.5",
    "vite-plus": "catalog:"
  },
  "engines": {
    "node": ">=22.18"
  },
  "packageManager": "pnpm@12.14.0",
  "cloudflare": {
    "bindings": {
      "APP_ID": {
        "description": "Dropbox **App key** from the [Dropbox App Console](https://www.dropbox.com/developers/apps)"
      },
      "APP_SECRET": {
        "description": "Dropbox **App secret** from the same app"
      },
      "REFRESH_TOKEN": {
        "description": "Run the app locally and open `/api/auth` once to get it, see the [README](https://github.com/ArnabXD/Dropbox-Index#3-get-the-refresh-token)"
      }
    }
  }
}
